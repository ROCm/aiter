+void Context::DestroyAdditionalEndpoints(const std::vector<RdmaEndpoint>& endpoints,
+                                         int qpPerPe) {
+  assert(endpoints.size() == static_cast<size_t>(WorldSize()) * qpPerPe);
+  for (int peer = 0; peer < WorldSize(); peer++) {
+    for (int qp = 0; qp < qpPerPe; qp++) {
+      const auto& ep = endpoints[peer * qpPerPe + qp];
+      if (ep.vendorId == RdmaDeviceVendorId::Unknown) continue;
+      RdmaDeviceContext* ctx = proxyEnabled ? GetRailContext(peer) : rdmaDeviceContext.get();
+      if (ctx) ctx->DestroyRdmaEndpointNoThrow(ep);
+    }
+  }
+}
+
 }  // namespace application
