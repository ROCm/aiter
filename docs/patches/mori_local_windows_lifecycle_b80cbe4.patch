+bool IonicDeviceContext::DestroyRdmaEndpointNoThrow(const RdmaEndpoint& ep) noexcept {
+  try {
+    if (ep.vendorId != RdmaDeviceVendorId::Pensando) return false;
+    auto qp = qpPool.find(ep.handle.qpn);
+    if (qp == qpPool.end()) return true;
+    auto cq = cqPool.find(ep.handle.qpn);
+    if (cq == cqPool.end() || qp->second->GetSqAddress() != ep.wqHandle.sqAddr) {
+      MORI_APP_WARN("Ionic endpoint ownership mismatch while destroying qpn={}", ep.handle.qpn);
+      return false;
+    }
+    // A CQ must outlive its QP. The QP destructor also releases its atomic MR
+    // and buffer; provider callbacks release the descriptor rings.
+    delete qp->second;
+    qpPool.erase(qp);
+    delete cq->second;
+    cqPool.erase(cq);
+    MORI_APP_TRACE("Ionic endpoint destroyed: qpn={} remaining_qps={} remaining_cqs={}",
+                   ep.handle.qpn, qpPool.size(), cqPool.size());
+    return true;
+  } catch (...) {
+    return false;
+  }
+}
