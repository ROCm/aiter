aiter_meta
aiter/install_mode

# Large test data - should be stored externally or use Git LFS
*.pt
*.pth
*.bin
*.ckpt
op_tests/test_jenga_vsa/
op_tests/dump_data/

# Temporary and debug files
debug_log.txt
*.debug

# Build outputs and compilation artifacts
OUT_FOLDER/
*.att

# Large benchmark results - archive to Wiki or external storage
op_tests/moe_benchmarking_profiling/results/*.csv
scripts/results/*.csv

# Opus tuned/untuned CSVs (moved to aiter/configs/bf16_tuned_gemm.csv with libtype='opus' filter;
# autolog feature removed). Reject any re-introduction under aiter/ops/opus/configs/.
aiter/ops/opus/configs/

# Jupyter notebook checkpoints and outputs
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# vim swaps
*.swo
*.swp

# Debug assembly dumps from csrc/opus_gemm/gen_co/build_co.py. The .co files
# next to them ARE tracked (the wheel needs them); these are just for analysis.
csrc/opus_gemm/gen_co/*/asm/

# Backstop for local runs of .github/scripts/update_split_test_times.py, whose
# --summary-path still defaults to the working directory. The workflow itself
# now writes both files to the runner temp dir and limits what its bot may
# commit, after copies of them reached the repo root in #5131.
/pr-body.md
/split-tests-update-summary.md

# Merge-conflict backups, which git writes next to the file being merged.
*.orig
