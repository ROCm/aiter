{
    "default": {
        "NUM_ITER": 2,
        "BLOCK_SIZE_M": 64,
        "BLOCK_SIZE_N": 64,
        "NUM_WARPS": 4
    },
    "rules": [
        {
            "if": {"M_leq": 32},
            "set": {"NUM_ITER": 1, "NUM_WARPS": 4}
        },
        {
            "if": {"M_gt": 32, "K_leq": 16384},
            "set": {"NUM_ITER": 1, "BLOCK_SIZE_M": 64, "BLOCK_SIZE_N": 128, "NUM_WARPS": 4}
        },
        {
            "if": {"M_gt": 32, "K_leq": 16384, "M_geq": 8192},
            "set": {"NUM_ITER": 2, "BLOCK_SIZE_N": 256}
        },
        {
            "if": {"M_gt": 32, "K_leq": 16384, "K_gt": 4096, "M_geq": 1024},
            "set": {"NUM_ITER": 1, "BLOCK_SIZE_N": 256, "NUM_WARPS": 2}
        },
        {
            "if": {"K_leq": 1024},
            "set": {"NUM_ITER": 1, "BLOCK_SIZE_M": 8, "NUM_WARPS": 4}
        },
        {
            "if": {"K_leq": 1024, "M_geq": 8192},
            "set": {"NUM_WARPS": 2}
        }
    ]
}

