{
    "default": {
        "NUM_ITER": 2,
        "BLOCK_SIZE_M": 64,
        "BLOCK_SIZE_N": 64,
        "NUM_WARPS": 4,
        "NUM_STAGES": 2
    },
    "rules": [
        {
            "if": {"M_leq": 32},
            "set": {"NUM_ITER": 1, "NUM_WARPS": 4, "NUM_STAGES": 1}
        },
        {
            "if": {"M_gt": 32, "N_leq": 16384},
            "set": {"BLOCK_SIZE_M": 32, "BLOCK_SIZE_N": 256}
        },
        {
            "if": {"N_leq": 1024},
            "set": {"NUM_ITER": 1, "NUM_WARPS": 4, "NUM_STAGES": 1}
        }
    ]
}

