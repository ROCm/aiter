extern "C" {
void {{func_name}}(const void* q_idx_ptr,
                   const void* key_cache_idx_ptr,
                   void* score_ptr,
                   const int* block_table_ptr,
                   const int* cu_seqlens_q_ptr,
                   const int* seq_lens_ptr,
                   const int num_reqs,
                   const int num_q_tiles,
                   const int block_table_stride,
                   const int score_head_stride,
                   const int score_num_stride,
                   const int num_chunks,
                   const int init_blocks,
                   const int local_blocks,
                   const int query_len,
                   void* stream);
}

void {{func_name}}(const void* q_idx_ptr,
                   const void* key_cache_idx_ptr,
                   void* score_ptr,
                   const int* block_table_ptr,
                   const int* cu_seqlens_q_ptr,
                   const int* seq_lens_ptr,
                   const int num_reqs,
                   const int num_q_tiles,
                   const int block_table_stride,
                   const int score_head_stride,
                   const int score_num_stride,
                   const int num_chunks,
                   const int init_blocks,
                   const int local_blocks,
                   const int query_len,
                   void* stream)
{
    (void)cu_seqlens_q_ptr;

    constexpr int BlockSize = {{block_size}};
    constexpr int HeadDim   = {{head_dim}};
    constexpr int H         = {{num_idx_heads}};
    constexpr int WAVES     = {{num_waves}};
    constexpr int QTILES    = {{q_tiles}};
    constexpr int PREFETCH  = {{prefetch}};
    constexpr bool NONTEMP  = {{non_temporal}};

    // Query-tile groups on x, requests on y, the block-range split on z. 
    dim3 grid(num_q_tiles, num_reqs, num_chunks);
    dim3 block(WAVES * aiter::sparse_attn::kWave);

    aiter::sparse_attn::
        pa_sparse_block_score_decode<BlockSize, HeadDim, H, WAVES, QTILES, PREFETCH, NONTEMP>
        <<<grid, block, 0, reinterpret_cast<hipStream_t>(stream)>>>(
            reinterpret_cast<const uint8_t*>(q_idx_ptr),
            reinterpret_cast<const uint8_t*>(key_cache_idx_ptr),
            reinterpret_cast<float*>(score_ptr),
            block_table_ptr,
            seq_lens_ptr,
            block_table_stride,
            score_head_stride,
            score_num_stride,
            num_chunks,
            init_blocks,
            local_blocks,
            query_len);
}
