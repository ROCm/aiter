#include "pa_sparse_block_select_kernels.cuh"

extern "C" {
void {{func_name}}(const void* score_ptr,
                   void* topk_idx_ptr,
                   const int* seq_lens_ptr,
                   const int* num_valid_pages_ptr,
                   const int* block_table_ptr,
                   const int* row_req_id_ptr,
                   const int* kv_lens_ptr,
                   void* sparse_bt_ptr,
                   void* sparse_ctx_ptr,
                   const int num_idx_heads,
                   const int total_q,
                   const int score_head_stride,
                   const int score_num_stride,
                   const int topk_head_stride,
                   const int topk_num_stride,
                   const int block_table_stride,
                   const int sparse_bt_stride,
                   const int num_kv_heads,
                   const int query_len,
                   void* stream);
}

void {{func_name}}(const void* score_ptr,
                   void* topk_idx_ptr,
                   const int* seq_lens_ptr,
                   const int* num_valid_pages_ptr,
                   const int* block_table_ptr,
                   const int* row_req_id_ptr,
                   const int* kv_lens_ptr,
                   void* sparse_bt_ptr,
                   void* sparse_ctx_ptr,
                   const int num_idx_heads,
                   const int total_q,
                   const int score_head_stride,
                   const int score_num_stride,
                   const int topk_head_stride,
                   const int topk_num_stride,
                   const int block_table_stride,
                   const int sparse_bt_stride,
                   const int num_kv_heads,
                   const int query_len,
                   void* stream)
{
    constexpr int BlockSize     = {{block_size}};
    constexpr int Slots         = {{slots}};
    constexpr int TopK          = {{topk}};
    constexpr int Waves         = {{num_waves}};
    constexpr int PagesPerBlock = {{pages_per_block}};

    dim3 grid(total_q, num_idx_heads);
    dim3 block(Waves * aiter::sparse_attn::kWave);
    aiter::sparse_attn::pa_sparse_block_topk_kernel<BlockSize, Slots, TopK, Waves, PagesPerBlock>
        <<<grid, block, 0, reinterpret_cast<hipStream_t>(stream)>>>(
            reinterpret_cast<const float*>(score_ptr),
            reinterpret_cast<int*>(topk_idx_ptr),
            seq_lens_ptr,
            num_valid_pages_ptr,
            block_table_ptr,
            row_req_id_ptr,
            kv_lens_ptr,
            reinterpret_cast<int*>(sparse_bt_ptr),
            reinterpret_cast<int*>(sparse_ctx_ptr),
            score_head_stride,
            score_num_stride,
            topk_head_stride,
            topk_num_stride,
            block_table_stride,
            sparse_bt_stride,
            num_kv_heads,
            query_len);
}
