+}
+
+run_v3_2p2d_warmup() {
+    if [[ "${MODEL_NAME}" != "DeepSeek-V3" || "${WIDE_EP_MODE}" != "0" \
+          || "${xP}" != "2" || "${yD}" != "2" \
+          || "${RUN_AFTER_HEALTH}" != "accuracy" ]]; then
+        return 0
+    fi
+
+    ensure_lm_eval || return $?
+    local base_url="http://127.0.0.1:${GATEWAY_PORT:-${PROXY_PORT}}/v1/completions"
+    local ts; ts="$(date +%Y%m%d_%H%M%S)"
+    local logf="${LOG_PATH}/warmup_${MODEL_NAME}_${PARALLEL_MODE}_${ts}.log"
+    log "DeepSeek-V3 2P2D warmup start: requests=64 concurrency=64 -> ${base_url}"
+
+    local warmup_rc=0
+    ( set -o pipefail
+      export HF_HUB_OFFLINE=0 HF_DATASETS_OFFLINE=0
+      python3 -m lm_eval --model local-completions \
+        --tasks gsm8k \
+        --limit 64 \
+        --model_args "model=${MODEL_PATH},base_url=${base_url},num_concurrent=64,max_retries=1,tokenized_requests=False,trust_remote_code=True,timeout=1200" \
+        2>&1 | tee "${logf}"
+    ) || warmup_rc=$?
+    if (( warmup_rc != 0 )); then
+        log "FAIL: DeepSeek-V3 2P2D warmup exited rc=${warmup_rc} — Log: ${logf}"
+        return "${warmup_rc}"
+    fi
+    log "DeepSeek-V3 2P2D warmup complete: requests=64 concurrency=64"
+}
+
+run_accuracy() {
+    ensure_lm_eval || return $?
