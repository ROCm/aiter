+def _mixed_decode_split(extend_seq_lens_cpu) -> Optional[tuple[int, int, int]]:
+    """Split point of a MIXED extend batch, from host-side lengths (no device sync).
+
+    ScheduleBatch.mix_with_running appends the running decode requests after the new extend
+    requests (one token each), and graph padding appends 0-token rows after those, so a mixed
+    batch is [extend seqs] + [n_dec seqs of 1 token] + [0-token padding]. Returns
+    (n_ext_seqs, n_dec, n_ext_tokens) when the batch has that shape with at least one seq of
+    more than 1 token in front and at least one 1-token tail, else None (one launch, as before).
+
+    Splitting lets the tails take unified_attention's decode route. In the single launch they ride
+    in programs sized for the prefill (BLOCK_M rows, BLOCK_M // num_queries_per_kv tokens) that
+    each hold one token and walk the tail's whole context alone; with a long context (gpt-oss
+    70000/300) that costs 0.25-0.5 ms per full-attention call at BLOCK_M 256.
+    """
+    lens = extend_seq_lens_cpu
+    if not lens:
+        return None
+    end = len(lens)
+    while end > 0 and lens[end - 1] == 0:  # graph padding: no tokens, no attention
+        end -= 1
+    n_ext = end
+    while n_ext > 0 and lens[n_ext - 1] == 1:
+        n_ext -= 1
+    n_dec = end - n_ext
+    if n_dec == 0 or n_ext == 0:
+        return None
+    return n_ext, n_dec, int(sum(lens[:n_ext]))
+
+
 class AiterAttnBackend(AttentionBackend):
     # kv_indptr/qo_indptr are preallocated at (req pool + 1); an extend batch
     # can never carry more seqs than the pool.
